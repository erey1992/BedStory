<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- solo para guardar dibujos en la galería en Android 9 o anterior -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- para grabar la voz en las historias con calcomanías; la grabación se queda en el teléfono -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <queries>
        <package android:name="com.whatsapp" />
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    </queries>
    <application android:allowBackup="false" android:label="Los Cuentos de Mamá Oca"
        android:icon="@mipmap/ic_launcher" android:supportsRtl="true" android:theme="@style/Theme.MamaOca">
        <activity android:name=".MainActivity" android:exported="true"
            android:screenOrientation="sensorLandscape" android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.fileprovider"
            android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
